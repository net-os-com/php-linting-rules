{
  "name": "net-os/php-linting-rules",
  "description": "Shared linting rules for PHP projects",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Net OS B.V.",
      "email": "software@net-os.com",
      "homepage": "https://net-os.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "larastan/larastan": "^3.0",
    "tightenco/tlint": "^9.5",
    "phpmd/phpmd": "^3.x-dev",
    "symplify/easy-coding-standard": "^12.5",
    "slevomat/coding-standard": "^8.0",
    "phpstan/phpstan-mockery": "^2.0",
    "mockery/mockery": "^1.6",
    "squizlabs/php_codesniffer": "3.13.2"
  },
  "autoload": {
    "psr-4": {
      "NetOSLint\\Configs\\": "configs/"
    }
  },
  "bin": [
    "bin/net-os-lint-setup"
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev"
}
